# Токен от @BotFather
BOT_TOKEN=

# Источник поиска yt-dlp: scsearch (SoundCloud) или ytsearch (YouTube)
SEARCH_SOURCE=scsearch

# Мини-приложение: публичный HTTPS-адрес, по которому доступен этот сервер
# (например https://mono.example.com). Пусто — мини-приложение выключено.
WEBAPP_URL=
WEBAPP_PORT=8080
